<div class="container" onclick="increment">
    <text class="count">{{ count }}</text>
    <div class="plus-row">
        <text class="plus" if="{{ plus === 'a' }}">+1</text>
        <text class="plus" if="{{ plus === 'b' }}">+1</text>
    </div>
    <image class="cookie" src="{{ cookieSrc }}"></image>
</div>
