<div class="container">
    <stack class="stage" if="{{ view === 'cookie' }}">
        <div class="column" onswipe="swipeCookie">
            <text class="count">{{ countText }}</text>
            <text class="rate" if="{{ noticeText === '' && frenzyText === '' }}">{{ rateText }}</text>
            <text class="notice" if="{{ noticeText !== '' }}">{{ noticeText }}</text>
            <text class="notice" if="{{ noticeText === '' && frenzyText !== '' }}">{{ frenzyText }}</text>
            <div class="plus-row">
                <text class="plus" if="{{ plus === 'a' }}">{{ plusText }}</text>
                <text class="plus" if="{{ plus === 'b' }}">{{ plusText }}</text>
            </div>
            <div class="cookie-box" onclick="increment">
                <image class="cookie" src="{{ cookieSrc }}"></image>
            </div>
        </div>
        <image class="golden-left" if="{{ golden === 'left' }}" src="/common/golden.png" onclick="clickGolden"></image>
        <image class="golden-right" if="{{ golden === 'right' }}" src="/common/golden.png" onclick="clickGolden"></image>
    </stack>
    <div class="view" if="{{ view === 'shop' }}">
        <text class="count">{{ countText }}</text>
        <list class="shop" ref="shopList">
            <list-item class="item" for="{{ items }}" onclick="buy($idx)">
                <text class="item-name" if="{{ $item.affordable }}">{{ $item.title }}</text>
                <text class="item-name-off" if="{{ !$item.affordable }}">{{ $item.title }}</text>
                <text class="item-detail">{{ $item.detail }}</text>
            </list-item>
        </list>
        <text class="button-wide" onclick="closeView">Back</text>
    </div>
    <div class="view" if="{{ view === 'achievements' }}">
        <text class="count">{{ achievedText }}</text>
        <list class="shop" ref="achievementList">
            <list-item class="item" for="{{ achievementItems }}">
                <text class="item-name" if="{{ $item.done }}">{{ $item.title }}</text>
                <text class="item-name-off" if="{{ !$item.done }}">{{ $item.title }}</text>
                <text class="item-detail" if="{{ $item.done }}">{{ $item.detail }}</text>
                <text class="item-detail-off" if="{{ !$item.done }}">{{ $item.detail }}</text>
            </list-item>
        </list>
        <text class="button-wide" onclick="closeView">Back</text>
    </div>
</div>
