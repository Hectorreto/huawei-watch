<div class="container">
    <stack class="stage" if="{{ view === 'cookie' }}">
        <div class="column">
            <text class="count">{{ countText }}</text>
            <text class="rate" if="{{ awayText === '' && frenzyText === '' }}">{{ rateText }}</text>
            <text class="away" if="{{ awayText !== '' }}">{{ awayText }}</text>
            <text class="away" if="{{ awayText === '' && frenzyText !== '' }}">{{ frenzyText }}</text>
            <div class="plus-row">
                <text class="plus" if="{{ plus === 'a' }}">{{ plusText }}</text>
                <text class="plus" if="{{ plus === 'b' }}">{{ plusText }}</text>
            </div>
            <div class="cookie-box" onclick="increment">
                <image class="cookie" src="{{ cookieSrc }}"></image>
            </div>
            <text class="button" onclick="openShop">Tienda</text>
        </div>
        <image class="golden-left" if="{{ golden === 'left' }}" src="/common/golden.png" onclick="clickGolden"></image>
        <image class="golden-right" if="{{ golden === 'right' }}" src="/common/golden.png" onclick="clickGolden"></image>
    </stack>
    <div class="view" if="{{ view === 'shop' }}">
        <text class="count">{{ countText }}</text>
        <list class="shop">
            <list-item class="item" for="{{ items }}" onclick="buy($idx)">
                <text class="item-name" if="{{ $item.affordable }}">{{ $item.title }}</text>
                <text class="item-name-off" if="{{ !$item.affordable }}">{{ $item.title }}</text>
                <text class="item-detail">{{ $item.detail }}</text>
            </list-item>
        </list>
        <text class="button" onclick="closeShop">Volver</text>
    </div>
</div>
