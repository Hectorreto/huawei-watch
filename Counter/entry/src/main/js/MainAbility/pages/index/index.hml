<div class="container">
    <stack class="stage" if="{{ view === 'cookie' }}">
        <div class="cookie-box" if="{{ !menu }}" onclick="increment" onswipe="swipeCookie">
            <image class="cookie" src="{{ cookieSrc }}"></image>
        </div>
        <div class="capsule" if="{{ !menu }}">
            <text class="count">{{ countText }}</text>
            <text class="rate" if="{{ noticeText === '' && frenzyText === '' }}">{{ rateText }}</text>
            <text class="notice" if="{{ noticeText !== '' }}">{{ noticeText }}</text>
            <text class="notice" if="{{ noticeText === '' && frenzyText !== '' }}">{{ frenzyText }}</text>
        </div>
        <div class="plus-row" if="{{ !menu }}">
            <text class="plus" if="{{ plus === 'a' }}">{{ plusText }}</text>
            <text class="plus" if="{{ plus === 'b' }}">{{ plusText }}</text>
        </div>
        <div class="menu-bg" if="{{ menu }}" onswipe="swipeCookie"></div>
        <image class="menu-cookie" if="{{ menu }}" src="/common/cookie_small.png" onclick="closeMenu" onswipe="swipeCookie"></image>
        <image class="menu-shop" if="{{ menu }}" src="/common/menu/shop.png" onclick="openShop"></image>
        <image class="menu-stats" if="{{ menu }}" src="/common/menu/stats.png"></image>
        <image class="menu-settings" if="{{ menu }}" src="/common/menu/settings.png"></image>
        <image class="menu-close" if="{{ menu }}" src="/common/menu/close.png" onclick="closeMenu"></image>
        <image class="menu-awards" if="{{ menu }}" src="/common/menu/awards.png" onclick="openAchievements"></image>
        <image class="menu-events" if="{{ menu }}" src="/common/menu/events.png"></image>
        <image class="golden-left" if="{{ golden === 'left' && !menu }}" src="/common/golden.png" onclick="clickGolden"></image>
        <image class="golden-right" if="{{ golden === 'right' && !menu }}" src="/common/golden.png" onclick="clickGolden"></image>
    </stack>
    <div class="shop-view" if="{{ view === 'shop' }}" onswipe="swipeBack">
        <text class="count">{{ countText }}</text>
        <text class="rate">{{ rateText }}</text>
        <text class="title">Shop</text>
        <list class="shop-list" ref="shopList">
            <list-item class="shop-item" for="{{ items }}" onclick="buy($idx)">
                <image class="shop-icon" src="{{ $item.icon }}"></image>
                <div class="shop-text">
                    <text class="shop-name">{{ $item.title }}</text>
                    <text class="shop-detail">{{ $item.detail }}</text>
                </div>
                <div class="price" if="{{ $item.affordable }}">
                    <image class="coin" src="/common/shop/coin.png"></image>
                    <text class="price-text">{{ $item.price }}</text>
                </div>
                <div class="price-off" if="{{ !$item.affordable }}">
                    <image class="coin" src="/common/shop/coin.png"></image>
                    <text class="price-text">{{ $item.price }}</text>
                </div>
            </list-item>
        </list>
    </div>
    <div class="shop-view" if="{{ view === 'achievements' }}" onswipe="swipeBack">
        <text class="title">Awards</text>
        <text class="rate">{{ achievedText }}</text>
        <list class="award-grid" ref="achievementList">
            <list-item class="award-row" for="{{ (ri, row) in awardRows }}">
                <div class="award-tile" for="{{ (ci, cat) in row.cats }}" onclick="openCategory(cat.id)">
                    <image class="award-tile-icon" src="{{ cat.icon }}"></image>
                    <text class="award-tile-name">{{ cat.name }}</text>
                    <text class="award-tile-count">{{ cat.count }}</text>
                </div>
            </list-item>
        </list>
    </div>
    <div class="shop-view" if="{{ view === 'category' }}" onswipe="swipeCategory">
        <text class="title">{{ categoryTitle }}</text>
        <text class="rate">{{ categoryCount }}</text>
        <list class="award-list" ref="categoryList">
            <list-item class="award-item" for="{{ categoryItems }}">
                <image class="award-icon" src="{{ $item.icon }}"></image>
                <div class="award-text">
                    <text class="award-name">{{ $item.title }}</text>
                    <text class="award-detail">{{ $item.detail }}</text>
                    <div class="progress-row" if="{{ $item.progress }}">
                        <progress class="bar" type="horizontal" percent="{{ $item.percent }}"></progress>
                        <text class="progress-text">{{ $item.progressText }}</text>
                    </div>
                </div>
                <image class="status" if="{{ $item.done }}" src="/common/awards/check.png"></image>
                <image class="status" if="{{ !$item.done }}" src="/common/awards/lock.png"></image>
            </list-item>
        </list>
    </div>
</div>
