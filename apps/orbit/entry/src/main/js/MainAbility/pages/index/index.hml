<stack class="container">
    <slider class="crown" ref="crown" min="0" max="{{ crownMax }}" value="{{ crownValue }}" onchange="crownTurn"></slider>
    <div class="ring"></div>
    <text class="score">{{ score }}</text>
    <text class="line">{{ line }}</text>
    <image class="diamond" src="/common/diamond.png" style="left: {{ gx }}px; top: {{ gy }}px;"></image>
    <image src="{{ s0 }}" style="left: {{ x0 }}px; top: {{ y0 }}px; width: {{ w0 }}px; height: {{ w0 }}px;"></image>
    <image src="{{ s1 }}" style="left: {{ x1 }}px; top: {{ y1 }}px; width: {{ w1 }}px; height: {{ w1 }}px;"></image>
    <image src="{{ s2 }}" style="left: {{ x2 }}px; top: {{ y2 }}px; width: {{ w2 }}px; height: {{ w2 }}px;"></image>
    <image src="{{ s3 }}" style="left: {{ x3 }}px; top: {{ y3 }}px; width: {{ w3 }}px; height: {{ w3 }}px;"></image>
    <image src="{{ s4 }}" style="left: {{ x4 }}px; top: {{ y4 }}px; width: {{ w4 }}px; height: {{ w4 }}px;"></image>
    <div class="ball" style="left: {{ bx }}px; top: {{ by }}px; background-color: {{ ballColour }};"></div>
    <div class="touch" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" onlongpress="step" onclick="step"></div>
</stack>
